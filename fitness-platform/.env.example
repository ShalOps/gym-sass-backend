# =================================================================
# Gym SaaS Backend - Environment Configuration
# =================================================================

# -------------------------
# DATABASE CONFIGURATION
# -------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/gym_saas_db"

# -------------------------
# APPLICATION SETTINGS
# -------------------------
PORT=3000
NODE_ENV="development"
JWT_SECRET="your_jwt_secret_here"

# -------------------------
# FILE STORAGE
# -------------------------
UPLOADS_DIR="./uploads"
THUMBNAIL_DIR="./uploads/thumbnails"

# -------------------------
# SECURITY & ENCRYPTION
# -------------------------
ENCRYPTION_KEY="your-32-char-secret-key"
ENABLE_QUERY_AUTH="false"

# -------------------------
# CORS CONFIGURATION
# -------------------------
# Comma-separated list of allowed origins for WebSocket connections
# Development defaults include common localhost ports
# Production: Add your actual domain(s)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:4200,http://localhost:8080,http://127.0.0.1:3000"

# -------------------------
# PAYMENT GATEWAY (CHAPA)
# -------------------------
CHAPA_TEST_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_TEST_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_SECRET_KEY="CHASECK-xxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="your-webhook-secret"

# -------------------------
# REDIS CACHE
# -------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TTL=3600

# -------------------------
# AI FEATURES (GOOGLE GEMINI)
# -------------------------
GEMINI_API_KEY="your-gemini-api-key-here"
ANONYMIZATION_SALT="your-secure-random-salt-for-user-id-anonymization"

# -------------------------
# TELEGRAM BOT
# -------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
BOT_NAME="your-bot-username"
APP_URL="https://your-app-domain.com"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# -------------------------
# EMAIL SERVICE (SMTP)
# -------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-email-app-password"