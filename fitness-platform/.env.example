# Environment Variables for Gym SaaS Backend

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/gym_saas_db"

# Secret key for JWT token signing (use a strong random string in production)
JWT_SECRET="your_jwt_secret_here"

# Directory path for file uploads (defaults to ./uploads)
UPLOADS_DIR="./uploads"

# Directory path for image thumbnails (defaults to ./uploads/thumbnails)
THUMBNAIL_DIR="./uploads/thumbnails"

# Application port (defaults to 3000)
PORT=3000

# Chapa Payment Gateway
CHAPA_TEST_PUBLIC_KEY="CHAPUBK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_TEST_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxxxxxx"
CHAPA_WEBHOOK_SECRET="your-webhook-secret"
CHAPA_SECRET_KEY="CHASECK-xxxxxxxxxxxxxxxx" # For production

# Environment
NODE_ENV="development"

# Encryption key for sensitive data (32 characters for AES-256)
# Use script.js to generate one
ENCRYPTION_KEY=your-32-char-secret-key

# Enable token in query params for WebSocket auth (only for development/testing)
ENABLE_QUERY_AUTH="false"

# CORS Configuration for WebSocket connections
# Comma-separated list of allowed origins for WebSocket connections
# Development defaults include common localhost ports
# Production: Add your actual domain(s)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:4200,http://localhost:8080,http://127.0.0.1:3000"