generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  WEIGHTLOSS
  YOGA
  BODYBUILDING
}

enum Role {
  CUSTOMER
  ADMIN
  GYMOWNER
  TRAINER
}

enum Gender {
  MALE
  FEMALE
}

enum Category {
  STRENGTH
  CARDIO
  CROSSFIT
  YOGA
}

enum PhotoEntityType {
  GYM
  CLASS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  PAID_MANUAL
}

enum PaymentType {
  MEMBERSHIP
  BOOKING
  PURCHASE
  PAYMENT_PLAN
  FREE_TRIAL
  MANUAL
  OTHER
}

model Payment {
  id                Int           @id @default(autoincrement())
  txRef             String        @unique @map("tx_ref") // Our generated unique reference (required by Chapa)
  chapaReference    String?       @map("chapa_reference") // The 'reference' returned by Chapa after verification
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("ETB")
  customerEmail     String?       @map("customer_email")
  customerFirstName String?       @map("customer_first_name")
  customerLastName  String?       @map("customer_last_name")
  checkoutUrl       String?       @map("checkout_url") // The Chapa payment page URL (useful for redirecting or debugging)
  callbackUrl       String?       @map("callback_url")
  returnUrl         String?       @map("return_url")
  status            PaymentStatus @default(PENDING)
  type              PaymentType
  method            String? // e.g. "telebirr", "card" (populated after verification)

  metadata      Json? // Custom metadata sent to Chapa
  chapaResponse Json? @map("chapa_response") // Full JSON response from Chapa (init or verify) for audit

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  verifiedAt     DateTime? @map("verified_at")
  refundedAt     DateTime? @map("refunded_at")
  refundedAmount Decimal?  @default(0) @map("refunded_amount") @db.Decimal(12, 2)

  userId           Int?
  serviceBookingId Int?
  classBookingId   Int?

  user           User?           @relation("UserPayments", fields: [userId], references: [userId], onDelete: SetNull)
  serviceBooking ServiceBooking? @relation("ServiceBookingPayments", fields: [serviceBookingId], references: [serviceBookingId], onDelete: SetNull)
  classBooking   ClassBooking?   @relation("ClassBookingPayments", fields: [classBookingId], references: [classBookingId], onDelete: SetNull)
  logs           PaymentLog[]

  @@index([txRef])
  @@index([chapaReference])
  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([serviceBookingId])
  @@index([classBookingId])
  @@index([createdAt])
  @@map("payments")
}

model User {
  userId                Int                      @id @default(autoincrement())
  firstName             String
  lastName              String
  userName              String                   @unique
  password              String
  birthDate             DateTime
  gender                Gender
  email                 String?                  @unique
  phoneNo               String?                  @unique
  profilePic            String?
  bio                   String?
  location              String
  goal                  Goal?
  role                  Role                     @default(CUSTOMER)
  gyms                  Gym[]
  gymclasses            GymClasses[]
  ClassBooking          ClassBooking[]
  ServiceBooking        ServiceBooking[]
  reviews               GymReview[]
  reviewResponses       GymReviewResponse[]
  classReviews          GymClassReview[]
  ownerClassResponses   GymClassReviewResponse[] @relation("OwnerResponses")
  trainerClassResponses GymClassReviewResponse[] @relation("TrainerResponses")
  payments              Payment[]                @relation("UserPayments")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  @@index([location])
  @@index([gender])
  @@index([goal])
  @@index([role])
}

model Gym {
  gymId                   Int                       @id @default(autoincrement())
  gymName                 String                    @unique
  contactNo               String?
  location                String
  workingHours            String?
  verified                Boolean                   @default(false)
  gymOwner                User                      @relation(fields: [gymOwnerId], references: [userId], onDelete: Restrict)
  gymOwnerId              Int
  services                Service[]
  gymClasses              GymClasses[]
  serviceOptions          ServiceOption[]
  serviceOptionAssignment ServiceOptionAssignment[]
  coverPhoto              Photo?                    @relation("gymCover", fields: [coverPhotoId], references: [id])
  coverPhotoId            Int?                      @unique
  reviews                 GymReview[]

  @@index([location])
  @@index([verified])
}

model Service {
  serviceId         Int                       @id @default(autoincrement())
  name              String
  price             Float
  duration          String
  category          Category
  target            String
  optionAssignments ServiceOptionAssignment[]
  gym               Gym                       @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId             Int
  serviceBookings   ServiceBooking[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([name, gymId])
}

model ServiceOption {
  optionId           Int                       @id @default(autoincrement())
  name               String
  serviceAssignments ServiceOptionAssignment[]
  gym                Gym                       @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId              Int

  @@unique([name, gymId])
}

model ServiceOptionAssignment {
  optionAssignmentId Int           @id @default(autoincrement())
  serviceId          Int
  optionId           Int
  gymId              Int
  service            Service       @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  option             ServiceOption @relation(fields: [optionId], references: [optionId], onDelete: Cascade)
  gym                Gym           @relation(fields: [gymId], references: [gymId], onDelete: Cascade)

  @@unique([serviceId, optionId, gymId])
}

model GymClasses {
  classId       Int      @id @default(autoincrement())
  className     String
  price         Float
  classSchedule String // must structure this later to parse schedule correctly
  capacity      Int
  duration      String
  gym           Gym      @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId         Int
  trainer       User     @relation(fields: [trainerId], references: [userId], onDelete: Restrict)
  trainerId     Int
  coverPhoto    Photo?   @relation("classCover", fields: [coverPhotoId], references: [id])
  coverPhotoId  Int?     @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classBookings ClassBooking[]
  reviews       GymClassReview[]
}

model Photo {
  id           Int             @id @default(autoincrement())
  url          String
  thumbnailUrl String?
  altText      String?
  entityType   PhotoEntityType
  entityId     Int
  isCover      Boolean         @default(false)
  order        Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  gymCover   Gym?        @relation("gymCover")
  classCover GymClasses? @relation("classCover")
}

model ClassBooking {
  classBookingId Int           @id @default(autoincrement())
  userId         Int
  classId        Int
  status         BookingStatus @default(PENDING)
  bookedAt       DateTime      @default(now())
  startTime      DateTime?
  endTime        DateTime?
  notes          String?

  payments Payment[] @relation("ClassBookingPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  class GymClasses @relation(fields: [classId], references: [classId], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@index([status])
  @@index([bookedAt])
}

model ServiceBooking {
  serviceBookingId Int           @id @default(autoincrement())
  userId           Int
  serviceId        Int
  status           BookingStatus @default(PENDING)
  bookedAt         DateTime      @default(now())
  startTime        DateTime?
  endTime          DateTime?
  notes            String?

  payments Payment[] @relation("ServiceBookingPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([bookedAt])
}

model GymReview {
  id        Int                @id @default(autoincrement())
  rating    Int                @default(1)
  comment   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  gym       Gym                @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId     Int
  user      User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    Int
  response  GymReviewResponse?
  isFlagged Boolean            @default(false)

  @@unique([gymId, userId])
  @@index([rating])
  @@index([createdAt])
}

model GymReviewResponse {
  responseId Int       @id @default(autoincrement())
  message    String
  createdAt  DateTime  @default(now())
  review     GymReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int       @unique
  owner      User      @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  ownerId    Int
}

model GymClassReview {
  id        Int        @id @default(autoincrement())
  rating    Int
  comment   String?
  class     GymClasses @relation(fields: [classId], references: [classId], onDelete: Cascade)
  classId   Int
  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  response GymClassReviewResponse?

  @@unique([classId, userId])
}

model GymClassReviewResponse {
  responseId Int            @id @default(autoincrement())
  message    String
  createdAt  DateTime       @default(now())
  review     GymClassReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int            @unique
  trainer    User?          @relation("TrainerResponses", fields: [trainerId], references: [userId], onDelete: SetNull)
  trainerId  Int?
  owner      User?          @relation("OwnerResponses", fields: [ownerId], references: [userId])
  ownerId    Int?
}

model PaymentLog {
  id        String   @id @default(cuid())
  paymentId Int      @map("payment_id")
  action    String // e.g., 'INIT', 'VERIFY', 'WEBHOOK'
  details   Json? // Non-sensitive metadata
  timestamp DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}
