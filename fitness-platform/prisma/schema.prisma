generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  userId         Int              @id @default(autoincrement())
  firstName      String
  lastName       String
  userName       String           @unique
  password       String
  birthDate      DateTime
  gender         Gender
  email          String?          @unique
  phoneNo        String?          @unique
  profilePic     String?
  bio            String?
  location       String
  goal           Goal?
  role           Role             @default(CUSTOMER)
  gyms           Gym[]
  gymclasses     GymClasses[]
  ClassBooking   ClassBooking[]
  ServiceBooking ServiceBooking[]

  @@index([location]) // For location filters
  @@index([gender]) // For gender filters
  @@index([goal]) // For goal filters
  @@index([role]) // For role filters
}

enum Goal {
  WEIGHTLOSS
  YOGA
  BODYBUILDING
}

enum Role {
  CUSTOMER
  ADMIN
  GYMOWNER
  TRAINER
}

enum Gender {
  MALE
  FEMALE
}

model Gym {
  gymId                   Int                       @id @default(autoincrement())
  gymName                 String                    @unique
  contactNo               String?
  location                String
  workingHours            String?
  verified                Boolean                   @default(false)
  gymOwner                User                      @relation(fields: [gymOwnerId], references: [userId], onDelete: Restrict)
  gymOwnerId              Int
  services                Service[]
  gymClasses              GymClasses[]
  serviceOptions          ServiceOption[]
  serviceOptionAssignment ServiceOptionAssignment[]
  coverPhoto              Photo?                    @relation("gymCover", fields: [coverPhotoId], references: [id])
  coverPhotoId            Int?                      @unique

  @@index([location])
  @@index([verified])
}

model Service {
  serviceId         Int                       @id @default(autoincrement())
  name              String
  price             Float
  duration          String // days or monthly/yearly
  category          Category
  target            String
  optionAssignments ServiceOptionAssignment[]
  gym               Gym                       @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId             Int
  serviceBookings   ServiceBooking[]

  @@unique([name, gymId])
}

model ServiceOption {
  optionId           Int                       @id @default(autoincrement())
  name               String
  serviceAssignments ServiceOptionAssignment[]
  gym                Gym                       @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId              Int

  @@unique([name, gymId])
}

model ServiceOptionAssignment {
  optionAssignmentId Int           @id @default(autoincrement())
  serviceId          Int
  optionId           Int
  gymId              Int
  service            Service       @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  option             ServiceOption @relation(fields: [optionId], references: [optionId], onDelete: Cascade)
  gym                Gym           @relation(fields: [gymId], references: [gymId], onDelete: Cascade)

  @@unique([serviceId, optionId, gymId])
}

model GymClasses {
  classId       Int    @id @default(autoincrement())
  className     String
  price         Float
  classSchedule String // must structure this later to parse schedule correctly
  capacity      Int
  duration      String // e.g. "1h", "45m"
  gym           Gym    @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId         Int
  trainer       User   @relation(fields: [trainerId], references: [userId], onDelete: Restrict)
  trainerId     Int
  coverPhoto    Photo? @relation("classCover", fields: [coverPhotoId], references: [id])
  coverPhotoId  Int?   @unique

  classBookings ClassBooking[]
}

model Photo {
  id           Int             @id @default(autoincrement())
  url          String
  thumbnailUrl String?
  altText      String?
  entityType   PhotoEntityType
  entityId     Int
  isCover      Boolean         @default(false)
  order        Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  gymCover   Gym?        @relation("gymCover")
  classCover GymClasses? @relation("classCover")
}

enum Category {
  STRENGTH
  CARDIO
  CROSSFIT
  YOGA
}

enum PhotoEntityType {
  GYM
  CLASS
}

model ClassBooking {
  classBookingId  Int           @id @default(autoincrement())
  userId          Int
  classId         Int
  status          BookingStatus @default(PENDING)
  bookedAt        DateTime      @default(now())
  startTime       DateTime?
  endTime         DateTime?
  notes           String?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  class GymClasses @relation(fields: [classId], references: [classId], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@index([status])
  @@index([bookedAt])
}

model ServiceBooking {
  serviceBookingId Int           @id @default(autoincrement())
  userId           Int
  serviceId        Int
  status           BookingStatus @default(PENDING)
  bookedAt         DateTime      @default(now())
  startTime        DateTime?
  endTime          DateTime?
  notes            String?
  paymentStatus    PaymentStatus @default(PENDING)
  paymentIntentId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([bookedAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSED
  FAILED
  REFUNDED
}
