// EAST
// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}




model User {
  userId    Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  userName    String    @unique
  password    String?                                         //added password it didn't exist in erdiagram
  birthDate   DateTime                                       //changed from age on erdiagram to birthdate
  gender      Gender
  email       String    @unique 
  phoneNo     String?   @unique
  profilePic  String?
  bio         String?
  location    String
  goal        Goal?
  role        Role      @default(CUSTOMER)
  gyms        Gym[]
  gymclasses       GymClasses[]

  @@index([location]) // For location filters
  @@index([gender]) // For gender filters
  @@index([goal]) // For goal filters
  @@index([role]) // For role filters
}

enum Goal {
  WEIGHTLOSS
  YOGA
  BODYBUILDING
}

enum Role {
  CUSTOMER
  ADMIN
  GYMOWNER
  TRAINER
}

enum Gender {
  MALE
  FEMALE
}






model Gym {
  gymId           Int         @id @default(autoincrement())
  gymName         String      @unique
  contactNo       String?
  location        String
  workingHours    String?
  verified        Boolean     @default(false)
  gymOwner        User      @relation(fields: [gymOwnerId], references: [userId])
  gymOwnerId      Int
  services        Service[]
  gymClasses      GymClasses[]

  @@index([location])
  @@index([verified])
}

model Service {
  serviceId   Int                 @id @default(autoincrement())
  name        String
  price       Float
  duration    String              // days or monthly/yearly
  category    Category
  target      String
  options     ServiceOption[]
  gym         Gym                 @relation(fields: [gymId], references: [gymId])
  gymId       Int
}

model ServiceOption {
  optionId    Int         @id   @default(autoincrement())
  name        String
  included    Boolean     @default(false)
  service     Service     @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  serviceId   Int         
}

model GymClasses {
  classId           Int         @id   @default(autoincrement())
  className         String
  price             Float
  classSchedule     String
  capacity          Int
  duration          String
  gym               Gym         @relation(fields: [gymId], references: [gymId])
  gymId             Int
  trainer           User        @relation(fields: [trainerId], references: [userId])
  trainerId         Int
}

enum Category {
  STRENGTH
  CARDIO
  CROSSFIT
  YOGA
}