generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  userName    String    @unique
  password    String?
  birthDate   DateTime
  gender      Gender
  email       String    @unique
  phoneNo     String?   @unique
  profilePic  String?
  bio         String?
  location    String
  goal        Goal?
  role        Role      @default(CUSTOMER)

  gyms        Gym[]     @relation("UserGyms")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gym {
  id           Int      @id @default(autoincrement())
  gymName      String   @unique
  contactNo    String?
  location     String
  workingHours String?
  verified     Boolean  @default(false)
  gymOwnerId   Int

  gymOwner     User     @relation("UserGyms", fields: [gymOwnerId], references: [id])
}

enum Goal {
  WEIGHTLOSS
  YOGA
  BODYBUILDING
}

enum Role {
  CUSTOMER
  ADMIN
  GYMOWNER
  TRAINER
}

enum Gender {
  MALE
  FEMALE
}
