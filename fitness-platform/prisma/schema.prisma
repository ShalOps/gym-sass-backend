generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  WEIGHTLOSS
  YOGA
  BODYBUILDING
}

enum Role {
  CUSTOMER
  ADMIN
  GYMOWNER
  TRAINER
  VENDOR
}

enum Gender {
  MALE
  FEMALE
}

enum Category {
  STRENGTH
  CARDIO
  CROSSFIT
  YOGA
}

enum PhotoEntityType {
  GYM
  CLASS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PROCESSED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  PAID_MANUAL
  DUPLICATE
  CANCELLED
}

enum PaymentType {
  MEMBERSHIP
  BOOKING
  PURCHASE
  PAYMENT_PLAN
  FREE_TRIAL
  MANUAL
  OTHER
}

enum NotificationType {
  NEW_CLASS_BOOKING
  NEW_SERVICE_BOOKING
  CLASS_BOOKING_CANCELLED
  SERVICE_BOOKING_CANCELLED
  CLASS_BOOKING_CONFIRMED
  SERVICE_BOOKING_CONFIRMED
  NEW_GYM_CREATED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum ConversationContext {
  GENERAL
  CLASS_INQUIRY
  SERVICE_BOOKING
  PRODUCT_INQUIRY
  ORDER_SUPPORT
  ADMIN_ANNOUNCEMENT
}

enum AttachmentType {
  IMAGE
  FILE
  VIDEO
  AUDIO
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum BroadcastStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum Channel {
  TELEGRAM
  EMAIL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payment {
  id                Int           @id @default(autoincrement())
  txRef             String        @unique @map("tx_ref") // Our generated unique reference (required by Chapa)
  chapaReference    String?       @map("chapa_reference") // The 'reference' returned by Chapa after verification
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("ETB")
  customerEmail     String?       @map("customer_email")
  customerFirstName String?       @map("customer_first_name")
  customerLastName  String?       @map("customer_last_name")
  checkoutUrl       String?       @map("checkout_url")
  callbackUrl       String?       @map("callback_url")
  returnUrl         String?       @map("return_url")
  status            PaymentStatus @default(PENDING)
  type              PaymentType
  method            String? // e.g. "telebirr", "card" (populated after business verification)

  metadata      Json? // Custom metadata sent to Chapa
  chapaResponse Json? @map("chapa_response") // Full JSON response from Chapa (init or verify) for audit

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  verifiedAt     DateTime? @map("verified_at")
  refundedAt     DateTime? @map("refunded_at")
  refundedAmount Decimal?  @default(0) @map("refunded_amount") @db.Decimal(12, 2)

  userId           Int?
  serviceBookingId Int?
  classBookingId   Int?

  user           User?           @relation("UserPayments", fields: [userId], references: [userId], onDelete: SetNull)
  serviceBooking ServiceBooking? @relation("ServiceBookingPayments", fields: [serviceBookingId], references: [serviceBookingId], onDelete: SetNull)
  classBooking   ClassBooking?   @relation("ClassBookingPayments", fields: [classBookingId], references: [classBookingId], onDelete: SetNull)
  logs           PaymentLog[]

  @@index([txRef])
  @@index([chapaReference])
  @@index([status])
  @@index([type])
  @@index([userId])
  @@index([serviceBookingId])
  @@index([classBookingId])
  @@index([createdAt])
  @@map("payments")
}

model User {
  userId                Int                       @id @default(autoincrement())
  firstName             String
  lastName              String
  userName              String                    @unique
  password              String
  birthDate             DateTime
  gender                Gender
  email                 String                    @unique
  phoneNo               String?                   @unique
  profilePic            String?
  bio                   String?
  location              String
  goal                  Goal?
  role                  Role                      @default(CUSTOMER)
  telegramChatId        BigInt?
  gyms                  Gym[]
  gymclasses            GymClasses[]
  ClassBooking          ClassBooking[]
  ServiceBooking        ServiceBooking[]
  reviews               GymReview[]
  reviewResponses       GymReviewResponse[]
  classReviews          GymClassReview[]
  ownerClassResponses   GymClassReviewResponse[]  @relation("OwnerResponses")
  trainerClassResponses GymClassReviewResponse[]  @relation("TrainerResponses")
  payments              Payment[]                 @relation("UserPayments")
  notifications         Notification[]
  conversations         ConversationParticipant[]
  messagesSent          Message[]
  chatReports           ChatReport[]
  broadcasts            BroadcastMessage[]
  trainers              Trainer?
  TrainerBookings       TrainerBooking[]
  TrainerReviews        TrainerReview[]


  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  @@index([location])
  @@index([gender])
  @@index([goal])
  @@index([role])
}

model Gym {
  gymId                   Int                       @id @default(autoincrement())
  gymName                 String                    @unique
  contactNo               String?
  location                String
  workingHours            String?
  timezone                String                    @default("UTC")
  verified                Boolean                   @default(false)
  gymOwner                User                      @relation(fields: [gymOwnerId], references: [userId], onDelete: Restrict)
  gymOwnerId              Int
  services                Service[]
  gymClasses              GymClasses[]
  serviceOptions          ServiceOption[]
  serviceOptionAssignment ServiceOptionAssignment[]
  coverPhoto              Photo?                    @relation("gymCover", fields: [coverPhotoId], references: [id])
  coverPhotoId            Int?                      @unique
  reviews                 GymReview[]
  trainersGyms            TrainerGym[]

  @@index([location])
  @@index([verified])
}

model Service {
  serviceId         Int                       @id @default(autoincrement())
  name              String
  price             Float
  duration          String
  category          Category
  target            String
  optionAssignments ServiceOptionAssignment[]
  gym               Gym                       @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId             Int
  serviceBookings   ServiceBooking[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([name, gymId])
}

model ServiceOption {
  optionId           Int                       @id @default(autoincrement())
  name               String
  serviceAssignments ServiceOptionAssignment[]
  gym                Gym                       @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId              Int

  @@unique([name, gymId])
}

model ServiceOptionAssignment {
  optionAssignmentId Int           @id @default(autoincrement())
  serviceId          Int
  optionId           Int
  gymId              Int
  service            Service       @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  option             ServiceOption @relation(fields: [optionId], references: [optionId], onDelete: Cascade)
  gym                Gym           @relation(fields: [gymId], references: [gymId], onDelete: Cascade)

  @@unique([serviceId, optionId, gymId])
}

model GymClasses {
  classId       Int      @id @default(autoincrement())
  className     String
  price         Float
  classSchedule String // must structure this later to parse schedule correctly
  capacity      Int
  duration      String
  gym           Gym      @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId         Int
  trainer       User     @relation(fields: [trainerId], references: [userId], onDelete: Restrict)
  trainerId     Int
  coverPhoto    Photo?   @relation("classCover", fields: [coverPhotoId], references: [id])
  coverPhotoId  Int?     @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classBookings ClassBooking[]
  reviews       GymClassReview[]
}

model Photo {
  id           Int             @id @default(autoincrement())
  url          String
  thumbnailUrl String?
  altText      String?
  entityType   PhotoEntityType
  entityId     Int
  isCover      Boolean         @default(false)
  order        Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  gymCover   Gym?        @relation("gymCover")
  classCover GymClasses? @relation("classCover")
}

model ClassBooking {
  classBookingId Int           @id @default(autoincrement())
  userId         Int
  classId        Int
  status         BookingStatus @default(PENDING)
  bookedAt       DateTime      @default(now())
  startTime      DateTime?
  endTime        DateTime?
  notes          String?

  payments Payment[] @relation("ClassBookingPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  class GymClasses @relation(fields: [classId], references: [classId], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@index([status])
  @@index([bookedAt])
}

model ServiceBooking {
  serviceBookingId Int           @id @default(autoincrement())
  userId           Int
  serviceId        Int
  status           BookingStatus @default(PENDING)
  bookedAt         DateTime      @default(now())
  startTime        DateTime?
  endTime          DateTime?
  notes            String?

  payments Payment[] @relation("ServiceBookingPayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([status])
  @@index([bookedAt])
}

model GymReview {
  id        Int                @id @default(autoincrement())
  rating    Int                @default(1)
  comment   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  gym       Gym                @relation(fields: [gymId], references: [gymId], onDelete: Cascade)
  gymId     Int
  user      User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    Int
  response  GymReviewResponse?
  isFlagged Boolean            @default(false)

  @@unique([gymId, userId])
  @@index([rating])
  @@index([createdAt])
}

model GymReviewResponse {
  responseId Int       @id @default(autoincrement())
  message    String
  createdAt  DateTime  @default(now())
  review     GymReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int       @unique
  owner      User      @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  ownerId    Int
}

model GymClassReview {
  id        Int        @id @default(autoincrement())
  rating    Int
  comment   String?
  class     GymClasses @relation(fields: [classId], references: [classId], onDelete: Cascade)
  classId   Int
  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  response GymClassReviewResponse?

  @@unique([classId, userId])
}

model GymClassReviewResponse {
  responseId Int            @id @default(autoincrement())
  message    String
  createdAt  DateTime       @default(now())
  review     GymClassReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId   Int            @unique
  trainer    User?          @relation("TrainerResponses", fields: [trainerId], references: [userId], onDelete: SetNull)
  trainerId  Int?
  owner      User?          @relation("OwnerResponses", fields: [ownerId], references: [userId])
  ownerId    Int?
}

model PaymentLog {
  id        String   @id @default(cuid())
  paymentId Int?     @map("payment_id")
  action    String // e.g., 'INIT', 'VERIFY', 'WEBHOOK'
  details   Json? // Non-sensitive metadata
  timestamp DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Notification {
  notificationId Int                @id @default(autoincrement())
  userId         Int
  user           User               @relation(fields: [userId], references: [userId])
  type           NotificationType
  message        String
  status         NotificationStatus @default(UNREAD)
  createdAt      DateTime           @default(now())

  @@index([userId])
}

model Conversation {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  isGroup Boolean @default(false)
  title   String? // Nullable, useful for group chats or ticket subjects

  context   ConversationContext @default(GENERAL)
  contextId String? // ID of the related entity (BookingID, OrderID, ProductID)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([context, contextId])
}

model ConversationParticipant {
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Int
  user           User         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId         Int

  joinedAt    DateTime @default(now())
  lastReadAt  DateTime @default(now())
  visibleFrom DateTime @default(now()) // Added for "Clear Chat" functionality
  isMuted     Boolean  @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id           Int       @id @default(autoincrement())
  clientSideId String    @unique
  content      String?   @db.Text // Nullable if only attachment
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isEdited     Boolean   @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId Int

  sender   User @relation(fields: [senderId], references: [userId], onDelete: Cascade)
  senderId Int

  replyToId Int?
  replyTo   Message?  @relation("ReplyTo", fields: [replyToId], references: [id])
  replies   Message[] @relation("ReplyTo")

  attachments MessageAttachment[]
  reports     ChatReport[]

  @@index([conversationId, createdAt(sort: Desc)])
}

model MessageAttachment {
  id        Int            @id @default(autoincrement())
  url       String
  filename  String
  mimeType  String
  type      AttachmentType
  size      Int
  createdAt DateTime       @default(now())

  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade) // Nullable for draft uploads
  messageId Int?
}

model ChatReport {
  id        Int          @id @default(autoincrement())
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  message   Message @relation(fields: [messageId], references: [id])
  messageId Int

  reporter   User @relation(fields: [reporterId], references: [userId])
  reporterId Int
}

model BroadcastMessage {
  id          String          @id @default(cuid())
  content     String
  targetRole  Role
  senderId    Int
  status      BroadcastStatus @default(PENDING)
  scheduledAt DateTime
  sentAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sender      User     @relation(fields: [senderId], references: [userId])

  @@map("broadcast_messages")
}

model FailedNotification {
  id          Int      @id @default(autoincrement())
  userId      Int
  channel     Channel
  payload     String
  attemptedAt DateTime @default(now())
}

model Trainer {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  bio                String?
  gender             String?
  dob                DateTime?
  hourlyRate         Decimal  @db.Decimal(10, 2)
  specializations    Json
  yearsOfExperience  Int
  profilePicture     String?
  certificationFiles Json
  verified           Boolean  @default(false)
  verificationStatus VerificationStatus   @default(PENDING)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Relations
  user          User                 @relation(fields: [userId], references: [userId])
  availability  TrainerAvailability[]
  gyms          TrainerGym[]
  bookings      TrainerBooking[]
  reviews       TrainerReview[]
}

model TrainerAvailability {
  id          Int      @id @default(autoincrement())
  trainerId   Int
  dayOfWeek   Int      // 0 = Sunday, 6 = Saturday
  startTime   DateTime
  endTime     DateTime
  isRecurring Boolean  @default(true)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, dayOfWeek])
}

model TrainerGym {
  id        Int @id @default(autoincrement())
  trainerId Int
  gymId     Int

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  gym     Gym     @relation(fields: [gymId], references: [gymId], onDelete: Cascade)

  @@unique([trainerId, gymId])
}


model TrainerBooking {
  id               Int      @id @default(autoincrement())
  userId           Int
  trainerId        Int
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  sessionType      String
  status           BookingStatus @default(PENDING)
  rescheduledFrom  Int?
  createdAt        DateTime @default(now())

  /// Relations
  user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  trainer  Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  review   TrainerReview?

  originalBooking TrainerBooking? @relation("Reschedule", fields: [rescheduledFrom], references: [id])
  reschedules      TrainerBooking[] @relation("Reschedule")

  @@index([trainerId, date])
}

model TrainerReview {
  id        Int    @id @default(autoincrement())
  trainerId Int
  userId    Int
  bookingId Int   @unique
  rating    Int
  comment   String?

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  booking TrainerBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model VerificationRequest {
  id                Int      @id @default(autoincrement())
  trainerId         Int
  trainer           Trainer  @relation(fields: [trainerId], references: [id])
  requestedChanges  Json     // Stores the DTO (yearsOfExp, certs, etc.)
  status            VerificationStatus @default(PENDING)
  createdAt         DateTime @default(now())
}



